# Copy to .env (git-ignored) and fill in. Never commit real values.
GERONIMO_BASE_URL=http://localhost:8080
GERONIMO_GOOGLE_CLIENT_ID=
GERONIMO_GOOGLE_CLIENT_SECRET=
# Required. Base64 of 32 random bytes: openssl rand -base64 32
# Keep it stable and back it up apart from the database. Losing it forces every user to reconnect Gmail.
GERONIMO_TOKEN_KEY=
# Optional
# GERONIMO_ADDR=localhost:8080
# GERONIMO_DB_PATH=geronimo.db
